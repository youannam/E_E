import { useEffect, useMemo, useState, type FormEvent } from "react";
import { api } from "../api/client";
import { PageHeader } from "../components/Layout";

type Item = { id: number; title: string; description: string; category: string; status: string; created_at: string | null };
type ModuleRecord = Record<string, unknown>;
type WorkspaceResponse = { items: Item[]; job_role: string; is_admin: boolean };
const profiles: Record<string, { heading: string; intro: string; categories: string[] }> = {
  administrator: { heading: "Administrator Workspace", intro: "Review workspace tasks across accounts. Existing security administration remains available in the original admin pages.", categories: ["TASK", "PROJECT", "PERSONAL"] },
  "security analyst": { heading: "Security Analyst Workspace", intro: "Track follow-up tasks related to investigations without replacing the existing alert and evidence workflows.", categories: ["TASK", "PROJECT", "PERSONAL"] },
  "it support": { heading: "IT Support Workspace", intro: "Track support requests and device/account follow-ups. Security investigations remain separately permission-controlled.", categories: ["SUPPORT", "TASK", "PERSONAL"] },
  "system administrator": { heading: "IT Support Workspace", intro: "Track device status and technical support follow-ups. Security investigations remain separately permission-controlled.", categories: ["SUPPORT", "TASK", "PERSONAL"] },
  "it": { heading: "IT Support Workspace", intro: "Track support requests and device/account follow-ups. Security investigations remain separately permission-controlled.", categories: ["SUPPORT", "TASK", "PERSONAL"] },
  "software engineer": { heading: "Software Engineering Workspace", intro: "Organize development tasks and project follow-ups without granting access to security evidence.", categories: ["PROJECT", "TASK", "PERSONAL"] },
  "developer": { heading: "Software Engineering Workspace", intro: "Organize development tasks and project follow-ups without granting access to security evidence.", categories: ["PROJECT", "TASK", "PERSONAL"] },
  "hr specialist": { heading: "HR Workspace", intro: "Track HR requests and follow-ups. This workspace does not expose sensitive employee records.", categories: ["HR_REQUEST", "TASK", "PERSONAL"] },
  "hr": { heading: "HR Workspace", intro: "Track HR requests and follow-ups. This workspace does not expose sensitive employee records.", categories: ["HR_REQUEST", "TASK", "PERSONAL"] },
  "human resources": { heading: "HR Workspace", intro: "Track HR requests and follow-ups. This workspace does not expose sensitive employee records.", categories: ["HR_REQUEST", "TASK", "PERSONAL"] },
  "finance specialist": { heading: "Finance Workspace", intro: "Track finance requests and approvals as tasks. Financial records are not exposed by this workspace.", categories: ["FINANCE_REQUEST", "TASK", "PERSONAL"] },
  "finance": { heading: "Finance Workspace", intro: "Track finance requests and approvals as tasks. Financial records are not exposed by this workspace.", categories: ["FINANCE_REQUEST", "TASK", "PERSONAL"] },
  "employee": { heading: "My Employee Workspace", intro: "Manage your own tasks and requests. Other employees’ workspace items are private.", categories: ["PERSONAL", "TASK"] },
};
const label = (s: string) => s.replaceAll("_", " ").toLowerCase().replace(/\b\w/g, c => c.toUpperCase());
export function WorkspacePage() {
  const [data, setData] = useState<WorkspaceResponse | null>(null); const [moduleData, setModuleData] = useState<ModuleRecord[] | ModuleRecord | null>(null); const [supportTickets, setSupportTickets] = useState<ModuleRecord[]>([]); const [hrEmployees, setHrEmployees] = useState<ModuleRecord[]>([]); const [financeRecords, setFinanceRecords] = useState<ModuleRecord[]>([]); const [financeType, setFinanceType] = useState("INVOICE"); const [financeReference, setFinanceReference] = useState(""); const [financeDescription, setFinanceDescription] = useState(""); const [financeAmount, setFinanceAmount] = useState("0"); const [financeCurrency, setFinanceCurrency] = useState("EGP"); const [ticketTitle, setTicketTitle] = useState(""); const [ticketDescription, setTicketDescription] = useState(""); const [loading, setLoading] = useState(true); const [error, setError] = useState(""); const [title, setTitle] = useState(""); const [description, setDescription] = useState(""); const [category, setCategory] = useState("TASK"); const [busy, setBusy] = useState(false); const [deviceId, setDeviceId] = useState(""); const [deviceType, setDeviceType] = useState("WORKSTATION");
  const profile = useMemo(() => data?.is_admin ? profiles.administrator : profiles[(data?.job_role ?? "employee").trim().toLowerCase()] ?? profiles.employee, [data?.job_role, data?.is_admin]);
  async function load() { setLoading(true); setError(""); try { const result = await api.get<WorkspaceResponse>("/workspace"); setData(result); const role = result.job_role.trim().toLowerCase(); const endpoint = role.includes("it support") || role === "it" || role.includes("system administrator") ? "/it/devices" : role.includes("engineer") || role.includes("developer") ? "/engineering/projects" : role === "hr" || role.startsWith("hr ") || role.includes("human resources") ? "/hr/requests" : role.includes("finance") ? "/finance/requests" : role.includes("employee") ? "/employee/profile" : null; if (endpoint) { try { const resultData = await api.get<ModuleRecord[] | ModuleRecord>(endpoint); setModuleData(resultData); if (endpoint === "/it/devices") { setSupportTickets(await api.get<ModuleRecord[]>("/it/support-tickets")); setHrEmployees([]); setFinanceRecords([]); } else if (endpoint === "/hr/requests") { setHrEmployees(await api.get<ModuleRecord[]>("/hr/employees")); setSupportTickets([]); setFinanceRecords([]); } else if (endpoint === "/finance/requests") { setFinanceRecords(await api.get<ModuleRecord[]>("/finance/records")); setSupportTickets([]); setHrEmployees([]); } else { setSupportTickets([]); setHrEmployees([]); setFinanceRecords([]); } } catch (e) { setModuleData(null); setError(e instanceof Error ? e.message : "Could not load the role-specific module."); } } else { setModuleData(null); setSupportTickets([]); } } catch (e) { setError(e instanceof Error ? e.message : "Could not load workspace."); } finally { setLoading(false); } }
  useEffect(() => { void load(); }, []);
  async function create(e: FormEvent) { e.preventDefault(); if (title.trim().length < 2) return; setBusy(true); setError(""); try { await api.post<Item>("/workspace", { title: title.trim(), description: description.trim(), category }); setTitle(""); setDescription(""); await load(); } catch (e) { setError(e instanceof Error ? e.message : "Could not create item."); } finally { setBusy(false); } }
  async function createFinanceRecord(e: FormEvent) { e.preventDefault(); const amount = Number(financeAmount); if (financeReference.trim().length < 2 || !Number.isFinite(amount) || amount < 0) return; setBusy(true); setError(""); try { await api.post<ModuleRecord>("/finance/records", { record_type: financeType, reference: financeReference.trim(), description: financeDescription.trim(), amount, currency: financeCurrency }); setFinanceReference(""); setFinanceDescription(""); setFinanceAmount("0"); await load(); } catch (e) { setError(e instanceof Error ? e.message : "Could not create finance record."); } finally { setBusy(false); } }
  async function updateFinanceRecord(row: ModuleRecord, status: string) { setBusy(true); try { await api.patch<ModuleRecord>(`/finance/records/${String(row.id)}`, { status }); await load(); } catch (e) { setError(e instanceof Error ? e.message : "Could not update finance record."); } finally { setBusy(false); } }
  async function createTicket(e: FormEvent) { e.preventDefault(); if (ticketTitle.trim().length < 2) return; setBusy(true); setError(""); try { await api.post<ModuleRecord>("/it/support-tickets", { title: ticketTitle.trim(), description: ticketDescription.trim() }); setTicketTitle(""); setTicketDescription(""); await load(); } catch (e) { setError(e instanceof Error ? e.message : "Could not create support ticket."); } finally { setBusy(false); } }
  async function createDevice(e: FormEvent) { e.preventDefault(); if (deviceId.trim().length < 2) return; setBusy(true); setError(""); try { await api.post<ModuleRecord>("/it/devices", { device_id: deviceId.trim(), device_type: deviceType }); setDeviceId(""); await load(); } catch (e) { setError(e instanceof Error ? e.message : "Could not create device."); } finally { setBusy(false); } }
  async function updateDevice(row: ModuleRecord, status: string) { setBusy(true); try { await api.patch<ModuleRecord>(`/it/devices/${String(row.id)}`, { status }); await load(); } catch (e) { setError(e instanceof Error ? e.message : "Could not update device."); } finally { setBusy(false); } }
  async function update(item: Item, status: string) { setBusy(true); try { await api.patch<Item>(`/workspace/${item.id}`, { status }); await load(); } catch (e) { setError(e instanceof Error ? e.message : "Could not update item."); } finally { setBusy(false); } }
  return <section className="page">
    <PageHeader title={profile.heading} subtitle={profile.intro} actions={<button className="button button-secondary" onClick={() => void load()}>Refresh</button>} />
    {error && <div className="notice notice-error" role="alert">{error}</div>}
    {data && (data.job_role.toLowerCase().includes("it support") || data.job_role.toLowerCase() === "it" || data.job_role.toLowerCase().includes("system administrator")) && <section className="panel" style={{ marginBottom: 20 }}><div className="section-heading"><div><h2>Device inventory</h2><p className="muted">Device status only; raw security evidence remains permission-controlled.</p></div><span className="count-pill">{Array.isArray(moduleData) ? moduleData.length : 0} devices</span></div><form className="workspace-form" onSubmit={createDevice}><label>Device ID<input value={deviceId} onChange={e => setDeviceId(e.target.value)} minLength={2} maxLength={80} required placeholder="e.g. WS-014" /></label><label>Device type<select value={deviceType} onChange={e => setDeviceType(e.target.value)}><option value="WORKSTATION">Workstation</option><option value="LAPTOP">Laptop</option><option value="USB_STORAGE">USB storage</option><option value="MOBILE">Mobile</option><option value="OTHER">Other</option></select></label><div><button className="button button-primary" disabled={busy || deviceId.trim().length < 2}>Add device</button></div></form>{Array.isArray(moduleData) && <div className="workspace-list">{moduleData.map(row => <article className="workspace-item" key={String(row.id)}><div className="workspace-item-main"><h3>{String(row.device_id ?? "Device")}</h3><p>{String(row.device_type ?? "Unknown type")} · Last seen {row.last_seen ? new Date(String(row.last_seen)).toLocaleString() : "not recorded"}</p></div><label className="workspace-status">Status<select value={String(row.status ?? "ACTIVE")} disabled={busy} onChange={e => void updateDevice(row, e.target.value)}>{["ACTIVE", "INACTIVE", "MAINTENANCE", "RETIRED"].map(v => <option key={v} value={v}>{label(v)}</option>)}</select></label></article>)}</div>}<div className="section-heading" style={{ marginTop: 22 }}><div><h2>Support tickets</h2><p className="muted">Technical support follow-ups, separate from security investigations.</p></div><span className="count-pill">{supportTickets.length} tickets</span></div><form className="workspace-form" onSubmit={createTicket}><label>Ticket title<input value={ticketTitle} onChange={e => setTicketTitle(e.target.value)} minLength={2} maxLength={160} required placeholder="e.g. Laptop setup" /></label><label className="workspace-description">Details<textarea value={ticketDescription} onChange={e => setTicketDescription(e.target.value)} rows={2} maxLength={4000} /></label><div><button className="button button-primary" disabled={busy || ticketTitle.trim().length < 2}>Create support ticket</button></div></form>{supportTickets.length > 0 && <div className="workspace-list" style={{ marginTop: 12 }}>{supportTickets.map(row => <article className="workspace-item" key={String(row.id)}><div className="workspace-item-main"><h3>{String(row.title ?? "Support ticket")}</h3><p>{String(row.description ?? "")}</p></div><span className={`status status-${String(row.status ?? "OPEN").toLowerCase()}`}>{label(String(row.status ?? "OPEN"))}</span></article>)}</div>}</section>}
    {data && (data.job_role.toLowerCase() === "hr" || data.job_role.toLowerCase().startsWith("hr ") || data.job_role.toLowerCase().includes("human resources")) && <section className="panel" style={{ marginBottom: 20 }}><div className="section-heading"><div><h2>Employee directory</h2><p className="muted">Basic work account details only. No security activity or alert evidence is exposed.</p></div><span className="count-pill">{hrEmployees.length} accounts</span></div>{hrEmployees.length ? <div className="workspace-list">{hrEmployees.map(row => <article className="workspace-item" key={String(row.id)}><div className="workspace-item-main"><h3>{String(row.username ?? "Employee")}</h3><p>{String(row.job_role ?? "Employee")} · {row.is_active ? "Active" : "Inactive"}</p></div></article>)}</div> : <p className="muted">No employee accounts found.</p>}</section>}
    {data && data.job_role.toLowerCase().includes("finance") && <section className="panel" style={{ marginBottom: 20 }}><div className="section-heading"><div><h2>Invoices, expenses & budgets</h2><p className="muted">Finance-only records. New records start pending approval.</p></div><span className="count-pill">{financeRecords.length} records</span></div><form className="workspace-form" onSubmit={createFinanceRecord}><label>Record type<select value={financeType} onChange={e => setFinanceType(e.target.value)}><option value="INVOICE">Invoice</option><option value="EXPENSE">Expense</option><option value="BUDGET">Budget</option></select></label><label>Reference<input value={financeReference} onChange={e => setFinanceReference(e.target.value)} minLength={2} maxLength={80} required placeholder="e.g. INV-2026-001" /></label><label>Amount<input type="number" value={financeAmount} onChange={e => setFinanceAmount(e.target.value)} min="0" step="0.01" required /></label><label>Currency<select value={financeCurrency} onChange={e => setFinanceCurrency(e.target.value)}>{["EGP", "USD", "EUR", "GBP", "SAR", "AED"].map(c => <option key={c}>{c}</option>)}</select></label><label className="workspace-description">Description<textarea value={financeDescription} onChange={e => setFinanceDescription(e.target.value)} rows={2} maxLength={1000} /></label><div><button className="button button-primary" disabled={busy || financeReference.trim().length < 2}>Add finance record</button></div></form>{financeRecords.length ? <div className="workspace-list" style={{ marginTop: 14 }}>{financeRecords.map(row => <article className="workspace-item" key={String(row.id)}><div className="workspace-item-main"><div className="workspace-item-meta"><span className="tag">{label(String(row.record_type ?? "RECORD"))}</span><span className={`status status-${String(row.status ?? "PENDING").toLowerCase()}`}>{label(String(row.status ?? "PENDING"))}</span></div><h3>{String(row.reference ?? "Record")} · {String(row.currency ?? "EGP")} {Number(row.amount ?? 0).toLocaleString()}</h3><p>{String(row.description ?? "")}</p></div><label className="workspace-status">Approval/status<select value={String(row.status ?? "PENDING")} disabled={busy} onChange={e => void updateFinanceRecord(row, e.target.value)}>{["PENDING", "APPROVED", "REJECTED", "PAID"].map(v => <option key={v} value={v}>{label(v)}</option>)}</select></label></article>)}</div> : <p className="muted">No finance records yet.</p>}</section>}
    {data && moduleData && !(data.job_role.toLowerCase().includes("it support") || data.job_role.toLowerCase() === "it" || data.job_role.toLowerCase().includes("system administrator")) && <section className="panel" style={{ marginBottom: 20 }}><div className="section-heading"><div><h2>{data.job_role.toLowerCase().includes("engineer") || data.job_role.toLowerCase().includes("developer") ? "Projects & build tasks" : data.job_role.toLowerCase().startsWith("hr ") || data.job_role.toLowerCase() === "hr" || data.job_role.toLowerCase().includes("human resources") ? "HR requests" : data.job_role.toLowerCase().includes("finance") ? "Finance requests" : "My employee profile"}</h2><p className="muted">Role-specific data is returned by a separate permission-checked API.</p></div></div>{Array.isArray(moduleData) ? moduleData.length ? <div className="workspace-list">{moduleData.map(row => <article className="workspace-item" key={String(row.id)}><div className="workspace-item-main"><div className="workspace-item-meta"><span className="tag">{label(String(row.category ?? data.job_role))}</span><span className={`status status-${String(row.status ?? "").toLowerCase()}`}>{label(String(row.status ?? "Available"))}</span></div><h3>{String(row.title ?? "Project")}</h3>{row.description && <p>{String(row.description)}</p>}</div></article>)}</div> : <p className="muted">No records yet. Use the form below to create a task or request.</p> : <div className="workspace-list">{Object.entries(moduleData).map(([key, value]) => <div className="workspace-item" key={key}><strong>{label(key)}</strong><span>{String(value ?? "—")}</span></div>)}</div>}</section>}
    <section className="panel" style={{ marginBottom: 20 }}><h2>Create a task or request</h2><form onSubmit={create} className="workspace-form"><label>Title<input value={title} onChange={e => setTitle(e.target.value)} minLength={2} maxLength={160} required placeholder="e.g. Follow up on a request" /></label><label>Type<select value={category} onChange={e => setCategory(e.target.value)}>{profile.categories.map(c => <option key={c} value={c}>{label(c)}</option>)}</select></label><label className="workspace-description">Description<textarea value={description} onChange={e => setDescription(e.target.value)} maxLength={4000} rows={3} placeholder="Add the details needed to complete this item" /></label><div><button className="button button-primary" disabled={busy || title.trim().length < 2}>{busy ? "Saving…" : "Create item"}</button></div></form></section>
    <section className="panel"><div className="section-heading"><div><h2>{data?.is_admin ? "Workspace items" : "My tasks and requests"}</h2><p className="muted">{data?.is_admin ? "Administrator view across accounts." : "Only your own items are shown."}</p></div><span className="count-pill">{data?.items.length ?? 0} items</span></div>
    {loading ? <p className="muted">Loading workspace…</p> : !data?.items.length ? <div className="empty-state"><h3>No tasks yet</h3><p className="muted">Create your first item above to start tracking work.</p></div> : <div className="workspace-list">{data.items.map(item => <article className="workspace-item" key={item.id}><div className="workspace-item-main"><div className="workspace-item-meta"><span className="tag">{label(item.category)}</span><span className={`status status-${item.status.toLowerCase()}`}>{label(item.status)}</span></div><h3>{item.title}</h3>{item.description && <p>{item.description}</p>}<small className="muted">Created {item.created_at ? new Date(item.created_at).toLocaleString() : "recently"}{data.is_admin ? ` · Account #${item.id}` : ""}</small></div><label className="workspace-status">Status<select value={item.status} disabled={busy} onChange={e => void update(item, e.target.value)}>{["OPEN", "IN_PROGRESS", "DONE", "CANCELLED"].map(s => <option key={s} value={s}>{label(s)}</option>)}</select></label></article>)}</div>}</section>
  </section>;
}
